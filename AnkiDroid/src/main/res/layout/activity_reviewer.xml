<!-- First child of DrawerLayout assumed to be main content, others are drawers.
 We use a Coordinator layout as root View for main content as it allows snackbars
 to be swiped off screen. Other behaviors can also be added in the future if necessary -->
<androidx.coordinatorlayout.widget.CoordinatorLayout android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Bring in each component from separate files as we have fullscreen versions of reviewer -->
    <RelativeLayout
        android:id="@+id/front_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <!-- The holder for the study surface. It is the first child, so the surface is drawn
             behind the chrome and the card, and it is larger than the surface, so that the
             surface's shadow has room to fall on the background. -->
        <FrameLayout
            android:id="@+id/study_surface_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/bottom_area_layout">
            <!-- The one surface the study screen is drawn on: the chrome (the toolbar, the counts,
                 the flag and the mark) and the card sit on it, so they read as a single object
                 instead of a stack of bands. Its colour and its shape come from the card style. -->
            <View
                android:id="@+id/study_surface"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
        <!-- The container allows edge-to-edge padding without it being absorbed
             by the Toolbar's minHeight, so the app bar keeps its full height -->
        <FrameLayout
            android:id="@+id/toolbar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">

            <include layout="@layout/include_toolbar"/>
        </FrameLayout>

        <include
            layout="@layout/include_reviewer_topbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/toolbar_container" />

        <include
            layout="@layout/include_reviewer_mic_tool_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/top_bar" />

        <include
            layout="@layout/include_reviewer_flashcard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/mic_tool_bar_layer" />

        <include
            layout="@layout/include_reviewer_whiteboard_editor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_above="@+id/bottom_area_layout"/>

        <include layout="@layout/include_reviewer_answer_buttons"
            tools:layout_width="match_parent"
            tools:layout_height="wrap_content"
            tools:layout_alignParentBottom="true"/>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
