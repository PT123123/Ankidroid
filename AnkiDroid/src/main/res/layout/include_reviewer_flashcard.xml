<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/flashcard"
        android:layout_margin="0dip"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/touch_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="0dip"
        android:longClickable="true" />
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/whiteboard"
        android:layout_margin="0dip"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <!--
         Above the touch layer, so that the chip can be tapped without the tap reaching the
         card. The overlay itself is not clickable: a tap that misses the chip falls through
         to the touch layer and flips the card, as it always did.
    -->
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/flashcard_overlay"
        android:layout_margin="0dip"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/card_style_button"
            android:layout_width="@dimen/card_style_chip_size"
            android:layout_height="@dimen/card_style_chip_size"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/card_style_chip_margin"
            android:background="@drawable/card_style_chip_background"
            android:contentDescription="@string/card_style_chip_description_default"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:scaleType="centerInside"
            android:src="@drawable/ic_card_style" />
    </FrameLayout>
</merge>
