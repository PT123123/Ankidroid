        <item name="colorPrimary">@color/tc_sky_primary</item>
        <item name="colorAccent">@color/tc_sky_accent</item>
        <item name="colorSecondaryContainer">@color/tc_sky_secondary_container</item>
        <item name="colorSurfaceContainer">@color/tc_sky_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/tc_sky_surface_container_high</item>
        <item name="preferenceCategoryTitleTextColor">@color/tc_sky_pref_category</item>
        <item name="fab_normal">@color/tc_sky_fab</item>
        <item name="fab_pressed">@color/tc_sky_fab_pressed</item>
        <item name="tabActiveIconColor">@color/tc_sky_tab_active_icon</item>
        <item name="appBarColor">@color/tc_sky_appbar</item>
        <item name="actionModeBackground">@color/tc_sky_appbar</item>
        <item name="tabLayoutBackgroundColor">@color/tc_sky_appbar</item>
        <item name="android:statusBarColor">@color/tc_sky_appbar</item>
        <item name="android:windowBackground">@drawable/theme_gradient_sky</item>
    </style>

