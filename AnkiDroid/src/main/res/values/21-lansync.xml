    <string name="lansync_pair" translatable="false">Pair</string>
    <string name="lansync_pair_hint" translatable="false">Show a code here, then type that code on the other device (or type its code here). Once the two devices are paired, each shows a short security code next to the other one in the device list - only sync while those codes match.</string>
    <string name="lansync_pair_show_code" translatable="false">Show my code</string>
    <string name="lansync_pair_showing" translatable="false">Your pairing code</string>
    <string name="lansync_pair_security_note" translatable="false">After the other device enters this code, both screens show a security code in their device list. Compare them there.</string>
    <string name="lansync_pair_expires" translatable="false">Expires in %1$d s - a code works once only.</string>
    <string name="lansync_pair_verify_warning" translatable="false">If the security codes on the two screens do not match, an attacker sits between you. Forget the device and pair again.</string>
    <string name="lansync_pair_done" translatable="false">Done</string>
    <string name="lansync_pair_new_code" translatable="false">New code</string>
    <string name="lansync_pair_with" translatable="false">Pair with %1$s</string>
    <string name="lansync_pair_code_label" translatable="false">6-digit code from the other device</string>

    <string name="lansync_schedule" translatable="false">Auto-sync</string>
    <string name="lansync_schedule_hint" translatable="false">Also syncs shortly after local edits and when a paired peer comes online.</string>
    <string name="lansync_schedule_off" translatable="false">Off</string>
    <string name="lansync_keep_online" translatable="false">Keep online</string>
    <string name="lansync_keep_online_hint" translatable="false">Keeps serving via a persistent notification after this screen closes. Some phone makers kill background services aggressively - exclude this app from battery optimisation if peers stop finding it.</string>
    <string name="lansync_keep_online_running" translatable="false">LAN sync stays reachable while this notification shows.</string>
    <string name="lansync_keep_online_dead" translatable="false">Keep-online is on but the server is not running - tap the switch off and on again.</string>

    <string name="lansync_plaintext_title" translatable="false">Allow plaintext v1 (dangerous)</string>
    <string name="lansync_plaintext_hint" translatable="false">Lets unpaired v1 devices push and pull whole collections with no encryption and no authentication. Every such round is marked in the activity list. Turn it off again once the legacy exchange is done.</string>

