<?xml version="1.0" encoding="utf-8"?>
<!-- Theme-color overlays applied on top of the active day/night theme
     (see Themes.applyThemeColor and R.style references from ThemeColor).
     Colors are qualified resources: values/theme_colors.xml for day,
     values-night/theme_colors.xml for night. -->
<resources>
