<!-- The selected deck's highlight: the themed fill on the corner-radius ramp's small step,
     so the highlight reads as a rounded card and not as a squared slab. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
        android:color="?attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_small" />
            <solid android:color="?attr/currentDeckBackgroundColor" />
        </shape>
    </item>
</ripple>