<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:drawable="@drawable/footer_button_tonal_shape" />
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/answer_button_corner_radius" />
                    <solid android:color="@color/footer_button_pressed_overlay" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item android:drawable="@drawable/footer_button_tonal_shape" />
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/answer_button_corner_radius" />
                    <solid android:color="@color/footer_button_focused_overlay" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:drawable="@drawable/footer_button_tonal_shape" />
        </layer-list>
    </item>
</selector>
